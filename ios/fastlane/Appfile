# Appfile for fastlane
# Documentation: https://docs.fastlane.tools/advanced/#appfile
#
# Team ID comes from Xcode (DEVELOPMENT_TEAM = 59S8HHXTXU).
# Override via env if needed: FASTLANE_USER, FASTLANE_TEAM_ID, FASTLANE_ITC_TEAM_ID

app_identifier("com.yky.clipvault")
apple_id(ENV["FASTLANE_USER"] || "wayneyu.dev@gmail.com")

team_id(ENV["FASTLANE_TEAM_ID"] || "59S8HHXTXU")

# App Store Connect team (only needed if your Apple ID has multiple teams)
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) if ENV["FASTLANE_ITC_TEAM_ID"] && !ENV["FASTLANE_ITC_TEAM_ID"].empty?

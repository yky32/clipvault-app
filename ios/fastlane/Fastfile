# ClipVal Fastlane — patterned after Depozio / Triftly (local Flutter + TestFlight).
# Fastfile lives in ios/fastlane/; project root is ../..

FASTLANE_DIR = File.dirname(__FILE__)
IOS_DIR = File.expand_path("..", FASTLANE_DIR)
PROJECT_ROOT = File.expand_path("..", IOS_DIR)

APP_IDENTIFIER = "com.clipval"
WIDGET_IDENTIFIER = "com.clipval.ClipValWidget"
SHARE_IDENTIFIER = "com.clipval.ClipValShare"
KEYBOARD_IDENTIFIER = "com.clipval.ClipValKeyboard"
APP_NAME = "ClipVal"
TEAM_ID = ENV["FASTLANE_TEAM_ID"] || "3G34999H3A"
APPLE_ID = ENV["FASTLANE_USER"] || "wayneyu.dev@gmail.com"

CI_SIGNING_KEYCHAIN_PASSWORD = "clipval-ci-keychain"

def ci_build?
  ENV["CI"] == "true"
end

# Short/full git SHA for Settings footer (v1.0.0 #abc1234) via --dart-define.
def git_commit_sha
  sha = ENV["GIT_COMMIT"].to_s.strip
  return sha unless sha.empty?

  out = `cd #{PROJECT_ROOT} && git rev-parse HEAD 2>/dev/null`.to_s.strip
  out
end

def flutter_git_define_args
  sha = git_commit_sha
  return "" if sha.empty?

  UI.message("🔖 Embedding GIT_COMMIT=#{sha[0, 7]}…")
  "--dart-define=GIT_COMMIT=#{sha}"
end

def path_for_system_ruby
  "/usr/bin:/usr/local/bin:#{ENV['PATH']}"
end

def gem_home_for_bundle
  home = ENV["HOME"] || ENV["USERPROFILE"] || Dir.home
  "#{home}/.gem/ruby/#{RbConfig::CONFIG['ruby_version']}"
end

def gem_path_for_bundle
  "#{gem_home_for_bundle}:/Library/Ruby/Gems/2.6.0"
end

def find_pod_command
  possible_paths = [
    "/Library/Ruby/Gems/2.6.0/bin/pod",
    "/usr/local/bin/pod",
    "/opt/homebrew/bin/pod"
  ]
  possible_paths.each do |path|
    return path if File.exist?(path)
  end
  pod_path = `which pod 2>/dev/null`.strip
  return pod_path unless pod_path.empty?

  "pod"
end

def run_pod_install
  install_script = File.join(IOS_DIR, "install_gems_and_pods.sh")
  if File.executable?(install_script) && ENV["CI"] != "true"
    UI.message("Running pod install via install_gems_and_pods.sh (rbenv Ruby 2.6)...")
    begin
      home = ENV["HOME"] || Dir.home
      sh(
        "cd #{PROJECT_ROOT} && env HOME=\"#{home}\" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 " \
        "#{install_script}",
        log: true
      )
      UI.success("✅ pod install completed (via install_gems_and_pods.sh)")
      return true
    rescue => script_ex
      UI.important("⚠️  install script failed: #{script_ex.message}")
    end
  end

  UI.message("Running pod install (trying bundle exec first)...")
  ruby_bin = RbConfig.ruby
  begin
    gem_home = gem_home_for_bundle
    gem_path = gem_path_for_bundle
    sh(
      "cd #{IOS_DIR} && env PATH=\"#{path_for_system_ruby}\" " \
      "GEM_HOME=\"#{gem_home}\" GEM_PATH=\"#{gem_path}\" " \
      "#{ruby_bin} -S bundle exec pod install --repo-update",
      log: true
    )
    UI.success("✅ pod install completed (bundle exec)")
    return true
  rescue => ex
    UI.important("⚠️  bundle exec pod failed: #{ex.message}")
    UI.important("Trying system pod...")
    pod_cmd = find_pod_command
    begin
      system_path = "/usr/bin:#{ENV['PATH']}"
      sh(
        "cd #{IOS_DIR} && env -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH " \
        "PATH=\"#{system_path}\" #{pod_cmd} install --repo-update",
        log: true
      )
      UI.success("✅ pod install completed (system pod)")
      return false
    rescue => sys_ex
      UI.important("⚠️  system pod also failed: #{sys_ex.message}")
      pods_lock = File.join(IOS_DIR, "Pods", "Manifest.lock")
      if File.exist?(pods_lock)
        UI.important("Continuing (Pods/Manifest.lock exists).")
        return true
      end
      UI.user_error!(
        "Pod install failed. From project root: ./ios/install_gems_and_pods.sh"
      )
    end
  end
end

def ensure_pod_wrapper_for_flutter
  wrapper_dir = File.join(IOS_DIR, ".pod_wrapper")
  FileUtils.mkdir_p(wrapper_dir)
  wrapper_script = File.join(wrapper_dir, "pod")
  gem_home = gem_home_for_bundle
  gem_path = gem_path_for_bundle
  script_content = <<~BASH
    #!/bin/bash
    export PATH="/usr/bin:/usr/local/bin:$PATH"
    export GEM_HOME="#{gem_home}"
    export GEM_PATH="#{gem_path}"
    cd #{IOS_DIR.inspect} && bundle exec pod "$@"
  BASH
  need_write = !File.exist?(wrapper_script) || File.read(wrapper_script) != script_content
  if need_write
    File.write(wrapper_script, script_content)
    File.chmod(0755, wrapper_script)
    UI.message("Created pod wrapper at #{wrapper_script}")
  end
  wrapper_dir
end

# Optional App Store Connect API key (CI / non-interactive). Local Apple ID 2FA also works.
def app_store_connect_api_key_params
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  key_path = File.join(Dir.home, ".appstoreconnect", "api_key.p8")
  return nil if key_id.to_s.empty? || issuer_id.to_s.empty?
  # CONTENT optional when CI already wrote ~/.appstoreconnect/api_key.p8
  return nil if key_content.to_s.empty? && !File.exist?(key_path)

  { key_id: key_id, issuer_id: issuer_id, key_content: key_content }
end

def build_app_store_connect_api_key
  params = app_store_connect_api_key_params
  return nil unless params

  key_path = File.join(Dir.home, ".appstoreconnect", "api_key.p8")
  # Prefer file path written by CI (avoids OpenSSL "invalid curve name" from mangled PEM)
  if File.exist?(key_path)
    return app_store_connect_api_key(
      key_id: params[:key_id],
      issuer_id: params[:issuer_id],
      key_filepath: key_path
    )
  end

  content = params[:key_content]
  is_b64 = ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true"
  if is_b64
    require "base64"
    FileUtils.mkdir_p(File.dirname(key_path))
    File.binwrite(key_path, Base64.decode64(content))
    return app_store_connect_api_key(
      key_id: params[:key_id],
      issuer_id: params[:issuer_id],
      key_filepath: key_path
    )
  end

  app_store_connect_api_key(
    key_id: params[:key_id],
    issuer_id: params[:issuer_id],
    key_content: content,
    is_key_content_base64: false
  )
end

# --- CI signing (Triftly pattern, single target com.clipval) ---

def ci_signing_keychain_path
  File.expand_path("~/Library/Keychains/clipval-ci.keychain-db")
end

def setup_ci_signing_keychain!
  keychain = ci_signing_keychain_path
  login_keychain = File.expand_path("~/Library/Keychains/login.keychain-db")

  sh("security delete-keychain '#{keychain}' 2>/dev/null || true", log: false)
  sh("security create-keychain -p '#{CI_SIGNING_KEYCHAIN_PASSWORD}' '#{keychain}'", log: false)
  sh("security unlock-keychain -p '#{CI_SIGNING_KEYCHAIN_PASSWORD}' '#{keychain}'", log: false)
  sh("security set-keychain-settings -lut 21600 '#{keychain}'", log: false)
  sh("security list-keychains -d user -s '#{keychain}' '#{login_keychain}'", log: false)
  keychain
end

def distribution_identity_installed?
  keychain = ENV["CI"] ? ci_signing_keychain_path : File.expand_path("~/Library/Keychains/login.keychain-db")
  output = `security find-identity -v -p codesigning '#{keychain}' 2>/dev/null`
  output.include?("Apple Distribution") && output.include?(TEAM_ID)
end

def import_distribution_certificate_for_ci!
  return false unless ENV["CI"]

  cert_b64 = ENV["IOS_DISTRIBUTION_CERT_BASE64"]
  return false if cert_b64.nil? || cert_b64.strip.empty?

  require "base64"
  p12_path = File.join(IOS_DIR, "distribution.ci.p12")
  File.binwrite(p12_path, Base64.decode64(cert_b64))

  keychain = setup_ci_signing_keychain!

  import_certificate(
    certificate_path: p12_path,
    certificate_password: ENV["IOS_DISTRIBUTION_CERT_PASSWORD"] || "",
    keychain_path: keychain,
    keychain_password: CI_SIGNING_KEYCHAIN_PASSWORD
  )

  sh(
    "security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{CI_SIGNING_KEYCHAIN_PASSWORD}' '#{keychain}'",
    log: false
  )

  File.delete(p12_path) if File.exist?(p12_path)
  UI.success("✅ Imported distribution certificate into CI keychain")
  true
ensure
  File.delete(p12_path) if defined?(p12_path) && p12_path && File.exist?(p12_path)
end

def fetch_appstore_profile!(app_identifier:, force: false)
  api_key = build_app_store_connect_api_key
  profile_options = {
    app_identifier: app_identifier,
    team_id: TEAM_ID,
    force: force
  }
  if api_key
    # Must pass the token object from build_app_store_connect_api_key (uses key_filepath)
    profile_options[:api_key] = api_key
  else
    profile_options[:username] = APPLE_ID
  end
  get_provisioning_profile(**profile_options)
  ENV["SIGH_NAME"]
end

def write_ci_export_options_plist!
  profile_name = ENV["SIGH_NAME"]
  widget_profile = ENV["SIGH_NAME_WIDGET"]
  share_profile = ENV["SIGH_NAME_SHARE"]
  keyboard_profile = ENV["SIGH_NAME_KEYBOARD"]
  UI.user_error!("SIGH_NAME is required to export the App Store IPA on CI.") unless profile_name
  UI.user_error!(
    "SIGH_NAME_WIDGET is required (ClipValWidget extension). Run setup_appstore_signing."
  ) unless widget_profile
  UI.user_error!(
    "SIGH_NAME_SHARE is required (ClipValShare extension). Run setup_appstore_signing."
  ) unless share_profile
  UI.user_error!(
    "SIGH_NAME_KEYBOARD is required (ClipValKeyboard extension). Run setup_appstore_signing."
  ) unless keyboard_profile

  plist_path = File.join(IOS_DIR, "ExportOptions.ci.plist")
  plist_content = <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store</string>
      <key>signingStyle</key>
      <string>manual</string>
      <key>teamID</key>
      <string>#{TEAM_ID}</string>
      <key>provisioningProfiles</key>
      <dict>
        <key>#{APP_IDENTIFIER}</key>
        <string>#{profile_name}</string>
        <key>#{WIDGET_IDENTIFIER}</key>
        <string>#{widget_profile}</string>
        <key>#{SHARE_IDENTIFIER}</key>
        <string>#{share_profile}</string>
        <key>#{KEYBOARD_IDENTIFIER}</key>
        <string>#{keyboard_profile}</string>
      </dict>
    </dict>
    </plist>
  PLIST

  File.write(plist_path, plist_content)
  plist_path
end

def persist_ci_signing_env!
  return unless ENV["CI"] && ENV["GITHUB_ENV"] && ENV["SIGH_NAME"]

  File.open(ENV["GITHUB_ENV"], "a") do |file|
    file.puts "SIGH_NAME=#{ENV['SIGH_NAME']}"
    file.puts "SIGH_NAME_WIDGET=#{ENV['SIGH_NAME_WIDGET']}" if ENV["SIGH_NAME_WIDGET"]
    file.puts "SIGH_NAME_SHARE=#{ENV['SIGH_NAME_SHARE']}" if ENV["SIGH_NAME_SHARE"]
    file.puts "SIGH_NAME_KEYBOARD=#{ENV['SIGH_NAME_KEYBOARD']}" if ENV["SIGH_NAME_KEYBOARD"]
  end
end

# Register App ID + App Groups (needed for keyboard shared suite).
def ensure_devcenter_app_id!(identifier, name:)
  UI.message("Ensuring Developer Portal App ID #{identifier}...")
  unless connect_api_for_spaceship
    UI.user_error!(
      "ASC API key required to create App ID #{identifier}. " \
      "Set APP_STORE_CONNECT_API_KEY_* secrets."
    )
  end

  existing = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: identifier }).first
  if existing
    UI.important("App ID already exists: #{identifier} (#{existing.id})")
    bid = existing
  else
    bid = Spaceship::ConnectAPI::BundleId.create(
      name: name,
      identifier: identifier,
      platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS
    )
    UI.success("Created App ID: #{identifier}")
  end

  begin
    caps = bid.get_capabilities
    has_groups = caps.any? { |c| c.is_type?(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS) }
    unless has_groups
      bid.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)
      UI.success("Enabled App Groups capability on #{identifier}")
    else
      UI.message("App Groups capability already on #{identifier}")
    end
  rescue => cap_ex
    UI.important("App Groups capability: #{cap_ex.message}")
  end

  # Portal can assign group.com.clipval (ASC API key cannot).
  associate_app_group_via_portal!(identifier, group_id: "group.com.clipval")
end

# Assign App Group via Developer Portal session (Apple ID).
def associate_app_group_via_portal!(bundle_id, group_id:)
  UI.message("Associating #{group_id} -> #{bundle_id} (Portal)...")
  begin
    user = ENV["FASTLANE_USER"] || ENV["SPACESHIP_USER"] || APPLE_ID
    pass = ENV["FASTLANE_PASSWORD"] || ENV["SPACESHIP_PASSWORD"] ||
           ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"]
    if user.to_s.empty?
      UI.important("No FASTLANE_USER — skip Portal App Group associate")
      return false
    end

    if pass.to_s.empty?
      Spaceship::Portal.login(user)
    else
      Spaceship::Portal.login(user, pass)
    end
    Spaceship::Portal.client.team_id = TEAM_ID if TEAM_ID.to_s != ""

    app = Spaceship::Portal.app.find(bundle_id)
    unless app
      UI.important("Portal app not found yet: #{bundle_id}")
      return false
    end

    begin
      app = app.update_service(Spaceship::Portal.app_service.app_group.on)
    rescue => svc_ex
      UI.important("update_service app_group: #{svc_ex.message}")
    end

    groups = Spaceship::Portal.app_group.all
    group = groups.find do |g|
      gid = (g.respond_to?(:group_id) ? g.group_id : nil) ||
            (g.respond_to?(:identifier) ? g.identifier : nil).to_s
      gid == group_id || g.inspect.include?(group_id)
    end
    unless group
      UI.message("Creating App Group #{group_id}...")
      group = Spaceship::Portal.app_group.create!(name: "ClipVal", group_id: group_id)
    end

    app.associate_groups([group])
    UI.success("Portal linked #{group_id} -> #{bundle_id}")
    true
  rescue => ex
    UI.important("Portal App Group associate failed: #{ex.message}")
    UI.important("One-time: Developer portal -> Identifiers -> #{bundle_id} -> App Groups -> #{group_id}")
    false
  end
end

def ensure_runner_ipa_path!
  # flutter build ipa may name the IPA after the product; normalize to Runner.ipa
  ipa_dir = File.join(PROJECT_ROOT, "build/ios/ipa")
  target = File.join(ipa_dir, "Runner.ipa")
  return if File.exist?(target)

  Dir.glob(File.join(ipa_dir, "*.ipa")).each do |path|
    next if File.basename(path) == "Runner.ipa"

    FileUtils.cp(path, target)
    UI.message("📦 Normalized IPA → Runner.ipa (from #{File.basename(path)})")
    return
  end
end

def connect_api_for_spaceship
  params = app_store_connect_api_key_params
  return nil unless params

  key_path = File.join(Dir.home, ".appstoreconnect", "api_key.p8")
  # Ensure PEM file exists when secret is base64-only
  if !File.exist?(key_path) && ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true"
    require "base64"
    FileUtils.mkdir_p(File.dirname(key_path))
    File.binwrite(key_path, Base64.decode64(params[:key_content]))
  end

  token = if File.exist?(key_path)
            Spaceship::ConnectAPI::Token.create(
              key_id: params[:key_id],
              issuer_id: params[:issuer_id],
              filepath: key_path
            )
          else
            Spaceship::ConnectAPI::Token.create(
              key_id: params[:key_id],
              issuer_id: params[:issuer_id],
              key: params[:key_content]
            )
          end

  Spaceship::ConnectAPI.token = token
  token
end

def prune_certificates_of_type(type, keep:, revoked_ids:)
  certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: type })
  certs = certs.reject { |cert| revoked_ids.include?(cert.id) }
  UI.message("Found #{certs.length} #{type} certificate(s)")
  return if certs.length <= keep

  sorted = certs.sort_by { |cert| cert.expiration_date.to_s }
  revoke_list = sorted[0...(sorted.length - keep)]
  revoke_list.each do |cert|
    UI.message("Revoking #{type} certificate #{cert.display_name} (#{cert.id})")
    cert.delete!
    revoked_ids << cert.id
  end
end

def read_pubspec_version
  pubspec_path = File.join(PROJECT_ROOT, "pubspec.yaml")
  unless File.exist?(pubspec_path)
    UI.user_error!("❌ pubspec.yaml not found at #{pubspec_path}")
  end
  content = File.read(pubspec_path)
  version_match = content.match(/^version:\s*(\d+\.\d+\.\d+)\+(\d+)/)
  unless version_match
    UI.user_error!("❌ Could not parse version from pubspec.yaml. Expected: version: 1.0.0+1")
  end
  [pubspec_path, content, version_match[1], version_match[2].to_i]
end

def write_pubspec_version(pubspec_path, content, version_name, build_number)
  new_content = content.gsub(
    /^version:\s*\d+\.\d+\.\d+\+\d+/,
    "version: #{version_name}+#{build_number}"
  )
  File.write(pubspec_path, new_content)
end

def increment_build_number_in_pubspec
  pubspec_path, content, version_name, current_build = read_pubspec_version
  new_build = current_build + 1

  UI.message("📦 Incrementing build number: #{current_build} → #{new_build}")
  write_pubspec_version(pubspec_path, content, version_name, new_build)
  UI.success("✅ Build number updated to #{new_build} (#{version_name}+#{new_build})")
  new_build
end

# Bump CFBundleShortVersionString patch (1.0.2 → 1.0.3) + build number.
# Used when ASC closes the pre-release train (90186 / 90062).
def increment_marketing_version_in_pubspec
  pubspec_path, content, version_name, current_build = read_pubspec_version
  parts = version_name.split(".").map(&:to_i)
  UI.user_error!("❌ Unexpected version name: #{version_name}") unless parts.length == 3

  parts[2] += 1 # patch
  new_version_name = parts.join(".")
  new_build = current_build + 1

  UI.message("📦 Marketing version closed on ASC — bumping #{version_name}+#{current_build} → #{new_version_name}+#{new_build}")
  write_pubspec_version(pubspec_path, content, new_version_name, new_build)
  UI.success("✅ Version updated to #{new_version_name}+#{new_build}")
  [new_version_name, new_build]
end

def version_tuple(version_name)
  version_name.to_s.split(".").map(&:to_i)
end

# Compare semver-ish a.b.c — returns -1 / 0 / 1
def compare_marketing_versions(a, b)
  version_tuple(a) <=> version_tuple(b)
end

# Widget + Share use hardcoded MARKETING_VERSION / CURRENT_PROJECT_VERSION
# (they do not inherit FLUTTER_BUILD_*). Keep them equal to pubspec or
# ASC rejects the IPA with the *extension* short version (often still 1.0.x).
def sync_extension_versions_from_pubspec!
  _path, _content, version_name, build_number = read_pubspec_version
  pbx_path = File.join(IOS_DIR, "Runner.xcodeproj/project.pbxproj")
  UI.user_error!("❌ Missing #{pbx_path}") unless File.exist?(pbx_path)

  content = File.read(pbx_path)
  # Only rewrite numeric literals — leave Runner's $(FLUTTER_BUILD_*) alone.
  updated = content
    .gsub(
      /MARKETING_VERSION = \d+\.\d+\.\d+;/,
      "MARKETING_VERSION = #{version_name};"
    )
    .gsub(
      /CURRENT_PROJECT_VERSION = \d+;/,
      "CURRENT_PROJECT_VERSION = #{build_number};"
    )

  if updated == content
    UI.message("📎 Extension MARKETING_VERSION already #{version_name}+#{build_number}")
  else
    File.write(pbx_path, updated)
    UI.success("📎 Synced Widget/Share MARKETING_VERSION → #{version_name}+#{build_number}")
  end
  [version_name, build_number]
end

# Highest App Store Connect marketing version that has closed (or is closing)
# the pre-release train — new TF builds must be *strictly greater*.
def fetch_app_store_train_floor_version
  begin
    require "spaceship"

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    unless app
      UI.important("⚠️  ASC app #{APP_IDENTIFIER} not found — skip proactive version check")
      return nil
    end

    floor = nil
    begin
      live = app.get_live_app_store_version
      floor = live.version_string if live && live.version_string
    rescue => ex
      UI.message("ℹ️  No live App Store version yet (#{ex.message})")
    end

    # Any version already approved / waiting for release also locks that train.
    closed_states = %w[
      READY_FOR_SALE
      PENDING_APPLE_RELEASE
      PENDING_DEVELOPER_RELEASE
      ACCEPTED
    ]

    begin
      versions = app.get_app_store_versions(limit: 30) || []
      versions.each do |v|
        state = v.app_store_state.to_s
        next unless closed_states.include?(state)
        vs = v.version_string.to_s
        next if vs.empty?
        if floor.nil? || compare_marketing_versions(vs, floor) > 0
          floor = vs
        end
      end
    rescue => ex
      UI.important("⚠️  Could not list ASC versions: #{ex.message}")
    end

    UI.message("🏪 ASC train floor (must upload > this): #{floor || 'none'}")
    floor
  rescue => ex
    UI.important("⚠️  ASC version lookup failed (will rely on upload retry): #{ex.message}")
    nil
  end
end

# Before build: if pubspec marketing ≤ ASC floor, patch-bump until strictly greater.
# Avoids a full failed IPA + rebuild cycle when 1.0.3 is already Ready for Sale.
def ensure_marketing_version_above_app_store_floor!
  floor = fetch_app_store_train_floor_version
  return nil if floor.nil? || floor.to_s.empty?

  pubspec_path, content, name, build = read_pubspec_version
  if compare_marketing_versions(name, floor) > 0
    UI.success("✅ pubspec #{name} > ASC floor #{floor} — train open")
    return nil
  end

  old = "#{name}+#{build}"
  while compare_marketing_versions(name, floor) <= 0
    parts = name.split(".").map(&:to_i)
    UI.user_error!("❌ Unexpected version name: #{name}") unless parts.length == 3
    parts[2] += 1
    name = parts.join(".")
    build += 1
  end

  UI.important("🚂 ASC floor is #{floor} — proactive bump #{old} → #{name}+#{build}")
  write_pubspec_version(pubspec_path, content, name, build)
  commit_and_push_build_number(
    build,
    commit_subject: "chore: Auto-bump marketing version to #{name}+#{build} [skip ci]",
    commit_body: "Proactive bump: App Store train floor #{floor} closed for new builds (ASC 90186/90062)."
  )
  [name, build]
end

def closed_app_store_train_error?(message)
  msg = message.to_s
  msg.include?("90186") ||
    msg.include?("90062") ||
    msg.include?("Invalid Pre-Release Train") ||
    msg.include?("closed for new build submissions") ||
    msg.include?("must contain a higher version than that of the previously approved version") ||
    msg.include?("This bundle is invalid. The value for key CFBundleShortVersionString")
end

# Read CFBundleShortVersionString from the built IPA (main app).
def read_ipa_short_version(ipa_path)
  begin
    FastlaneCore::IpaFileAnalyser.fetch_app_version(ipa_path)
  rescue => ex
    UI.important("⚠️  Could not analyse IPA version: #{ex.message}")
    nil
  end
end

def verify_ipa_matches_pubspec!(ipa_path)
  _p, _c, expected_name, expected_build = read_pubspec_version
  short = read_ipa_short_version(ipa_path)
  UI.message("📋 IPA short version=#{short.inspect} (expect #{expected_name}+#{expected_build})")

  if short && short != expected_name
    UI.user_error!(
      "❌ IPA CFBundleShortVersionString is #{short}, pubspec is #{expected_name}. " \
      "Extension targets may still be hardcoded — ensure sync_extension_versions_from_pubspec! ran."
    )
  end
  true
end

def flutter_version_build_args
  _p, _c, version_name, build_number = read_pubspec_version
  "--build-name=#{version_name} --build-number=#{build_number}"
end

def generate_release_notes
  begin
    unless system("cd #{PROJECT_ROOT} && git rev-parse --git-dir > /dev/null 2>&1")
      return "[Feature: Manual build]\n[Build time: #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}]"
    end

    commit_output = `cd #{PROJECT_ROOT} && git log -10 --pretty=format:"%H|%s" --no-merges`.strip
    valid_commits = []
    commit_output.split("\n").each do |line|
      next if line.empty?

      parts = line.split("|", 2)
      next if parts.length < 2

      commit_msg = parts[1].strip
      next if commit_msg.include?("Auto-increment build number") ||
              commit_msg.include?("chore: Auto-increment") ||
              commit_msg.include?("Auto-bump marketing version") ||
              commit_msg.include?("chore: Auto-bump")

      cleaned = commit_msg.length > 150 ? commit_msg[0..150] : commit_msg
      valid_commits << cleaned unless cleaned.empty?
      break if valid_commits.length >= 3
    end

    valid_commits = ["Manual build"] if valid_commits.empty?
    build_time = Time.now.strftime("%Y-%m-%d %H:%M:%S")
    parts = valid_commits.each_with_index.map { |msg, i| "[Feature #{i + 1}: #{msg}]" }
    parts << "[Build time: #{build_time}]"
    notes = parts.join("\n")
    UI.message("📝 Release notes:\n#{notes}")
    notes
  rescue => ex
    UI.important("⚠️  Failed to generate release notes: #{ex.message}")
    "[Feature: Manual build]\n[Build time: #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}]"
  end
end

def commit_and_push_build_number(new_build_number, commit_subject: nil, commit_body: nil)
  UI.message("📝 Committing pubspec version change...")
  begin
    unless system("cd #{PROJECT_ROOT} && git rev-parse --git-dir > /dev/null 2>&1")
      UI.important("⚠️  Not a git repository, skipping commit")
      return
    end

    git_status = `cd #{PROJECT_ROOT} && git status --porcelain pubspec.yaml`.strip
    if git_status.empty?
      UI.important("ℹ️  No changes to pubspec.yaml, skipping commit")
      return
    end

    subject = commit_subject ||
              "chore: Auto-increment build number to #{new_build_number} [skip ci]"
    body = commit_body ||
           "Build number automatically incremented by Fastfile"

    sh("cd #{PROJECT_ROOT} && git add pubspec.yaml")
    # [skip ci] prevents infinite Deploy loops on the bump commit (Triftly pattern).
    # Escape double-quotes in messages for the shell.
    subject_q = subject.gsub('"', '\\"')
    body_q = body.gsub('"', '\\"')
    sh(
      "cd #{PROJECT_ROOT} && git commit " \
      "-m \"#{subject_q}\" " \
      "-m \"#{body_q}\""
    )
    UI.success("✅ Version change committed")

    UI.message("🚀 Pushing to remote repository...")
    sh("cd #{PROJECT_ROOT} && git push")
    UI.success("✅ Version change pushed to remote")
  rescue => ex
    UI.important("⚠️  Failed to commit/push version: #{ex.message}")
    UI.important("   On CI: ensure GH_PAT (or contents:write) can push to main")
  end
end

default_platform(:ios)

platform :ios do
  desc "Build iOS app for development (Debug)"
  lane :build_debug do
    sh("cd #{PROJECT_ROOT} && flutter pub get")
    run_pod_install
    sh(
      "cd #{PROJECT_ROOT} && env -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH " \
      "flutter build ios --debug --no-codesign"
    )
    UI.success("✅ iOS Debug build completed!")
  end

  desc "Build iOS app for release (no codesign)"
  lane :build_release do
    sh("cd #{PROJECT_ROOT} && flutter pub get")
    run_pod_install
    sh(
      "cd #{PROJECT_ROOT} && env -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH " \
      "flutter build ios --release --no-codesign"
    )
    UI.success("✅ iOS Release build completed!")
  end

  desc "Build iOS app and create IPA (requires code signing)"
  desc "Options: export_method — development | ad-hoc | app-store | enterprise (default: development)"
  lane :build_ipa do |options|
    export_method = options[:export_method] || "development"

    sh("cd #{PROJECT_ROOT} && flutter pub get")

    UI.message("Ensuring bundle is up to date (ios/Gemfile)...")
    begin
      gem_home = gem_home_for_bundle
      sh(
        "cd #{IOS_DIR} && env PATH=\"#{path_for_system_ruby}\" " \
        "GEM_HOME=\"#{gem_home}\" GEM_PATH=\"#{gem_home}\" bundle install",
        log: true
      )
    rescue => ex
      UI.important("⚠️  bundle install had an issue: #{ex.message}")
    end

    # CI app-store: flutter build ipa runs pod install itself (Triftly pattern).
    if ci_build? && export_method == "app-store"
      UI.message("Skipping pre-build pod install on CI (flutter build ipa runs pod install)")
    else
      bundle_pod_ok = run_pod_install
      if bundle_pod_ok
        pod_wrapper_dir = ensure_pod_wrapper_for_flutter
        ENV["PATH"] = "#{pod_wrapper_dir}:#{ENV['PATH']}"
      end
    end

    if ci_build? && export_method == "app-store"
      UI.message("🔧 CI: applying App Store signing to Xcode project...")
      UI.user_error!(
        "SIGH_NAME must be set. Run setup_appstore_signing first (workflow step)."
      ) unless ENV["SIGH_NAME"]
      UI.user_error!(
        "SIGH_NAME_WIDGET must be set for ClipValWidget. Run setup_appstore_signing."
      ) unless ENV["SIGH_NAME_WIDGET"]
      UI.user_error!(
        "SIGH_NAME_SHARE must be set for ClipValShare. Run setup_appstore_signing."
      ) unless ENV["SIGH_NAME_SHARE"]
      UI.user_error!(
        "SIGH_NAME_KEYBOARD must be set for ClipValKeyboard. Run setup_appstore_signing."
      ) unless ENV["SIGH_NAME_KEYBOARD"]

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "#{IOS_DIR}/Runner.xcodeproj",
        team_id: TEAM_ID,
        bundle_identifier: APP_IDENTIFIER,
        profile_name: ENV["SIGH_NAME"],
        code_sign_identity: "Apple Distribution",
        targets: ["Runner"]
      )
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "#{IOS_DIR}/Runner.xcodeproj",
        team_id: TEAM_ID,
        bundle_identifier: WIDGET_IDENTIFIER,
        profile_name: ENV["SIGH_NAME_WIDGET"],
        code_sign_identity: "Apple Distribution",
        targets: ["ClipValWidget"]
      )
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "#{IOS_DIR}/Runner.xcodeproj",
        team_id: TEAM_ID,
        bundle_identifier: SHARE_IDENTIFIER,
        profile_name: ENV["SIGH_NAME_SHARE"],
        code_sign_identity: "Apple Distribution",
        targets: ["ClipValShare"]
      )
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "#{IOS_DIR}/Runner.xcodeproj",
        team_id: TEAM_ID,
        bundle_identifier: KEYBOARD_IDENTIFIER,
        profile_name: ENV["SIGH_NAME_KEYBOARD"],
        code_sign_identity: "Apple Distribution",
        targets: ["ClipValKeyboard"]
      )

      export_plist = write_ci_export_options_plist!
      sync_extension_versions_from_pubspec!
      ver_args = flutter_version_build_args
      UI.message("📦 Building IPA via flutter build ipa (#{ver_args})...")
      git_def = flutter_git_define_args
      sh(
        "cd #{PROJECT_ROOT} && flutter build ipa --release " \
        "#{ver_args} --export-options-plist=#{export_plist} #{git_def}"
      )
      ensure_runner_ipa_path!
    else
      sync_extension_versions_from_pubspec!
      ver_args = flutter_version_build_args
      git_def = flutter_git_define_args
      sh("cd #{PROJECT_ROOT} && flutter build ios --release --no-codesign #{ver_args} #{git_def}")

      export_opts = {
        method: export_method,
        signingStyle: "automatic",
        teamID: TEAM_ID
      }

      if export_method == "app-store"
        UI.message("📦 Ensuring App Store provisioning profile is available...")
        begin
          fetch_appstore_profile!(app_identifier: APP_IDENTIFIER)
          UI.success("✅ Provisioning profile ready")
        rescue => ex
          UI.important("⚠️  Could not fetch profile: #{ex.message}")
        end
      end

      build_app(
        workspace: "#{IOS_DIR}/Runner.xcworkspace",
        scheme: "Runner",
        export_method: export_method,
        output_directory: "#{PROJECT_ROOT}/build/ios/ipa",
        export_options: export_opts
      )
    end

    UI.success("✅ IPA created successfully!")
    UI.message("📦 IPA location: #{PROJECT_ROOT}/build/ios/ipa/")
  end

  desc "Build IPA and upload to TestFlight (auto build number + release notes)"
  desc "Options: skip_build:true — upload existing IPA only"
  lane :upload_testflight do |options|
    skip_build = options[:skip_build] || false
    api_key = build_app_store_connect_api_key

    unless skip_build
      # 1) If ASC already closed this marketing train, bump *before* building.
      ensure_marketing_version_above_app_store_floor!
      # 2) Always +1 build for this upload.
      UI.important("🔢 Auto-incrementing build number...")
      new_build_number = increment_build_number_in_pubspec
      commit_and_push_build_number(new_build_number)
      # 3) Keep Widget/Share MARKETING_VERSION in lockstep with pubspec.
      sync_extension_versions_from_pubspec!
      UI.important("")

      UI.important("📦 Building IPA for App Store / TestFlight...")
      build_success = false
      retry_count = 0
      max_retries = 1

      begin
        build_ipa(export_method: "app-store")
        build_success = true
      rescue => ex
        error_msg = ex.message
        is_signing_error = error_msg.include?("provisioning profile") ||
                           error_msg.include?("certificate") ||
                           error_msg.include?("signing") ||
                           error_msg.include?("CodeSign") ||
                           error_msg.include?("packaging")

        if is_signing_error && retry_count < max_retries
          retry_count += 1
          UI.important("🔧 Code signing issue — running setup_appstore_signing then retry...")
          begin
            setup_appstore_signing
            build_ipa(export_method: "app-store")
            build_success = true
          rescue => setup_ex
            UI.error("❌ Automatic certificate setup failed: #{setup_ex.message}")
            UI.error("   open ios/Runner.xcworkspace → Signing & Capabilities → team #{TEAM_ID}")
            UI.error("   Or: bundle exec fastlane ios setup_appstore_signing")
            raise
          end
        else
          UI.error("❌ Failed to build IPA: #{error_msg}")
          raise
        end
      end

      UI.user_error!("Failed to build IPA for App Store") unless build_success
    end

    ipa_path = "#{PROJECT_ROOT}/build/ios/ipa/Runner.ipa"
    unless File.exist?(ipa_path)
      UI.user_error!(
        "❌ IPA not found at #{ipa_path}. Build first or omit skip_build."
      )
    end
    verify_ipa_matches_pubspec!(ipa_path) unless skip_build

    UI.message("🚀 Uploading to TestFlight...")
    ENV["PILOT_APP_IDENTIFIER"] = APP_IDENTIFIER
    ENV.delete("SIGH_APP_IDENTIFIER")

    begin
      ipa_bundle_id = FastlaneCore::IpaFileAnalyser.fetch_app_identifier(ipa_path)
      UI.message("📋 IPA bundle ID: #{ipa_bundle_id || 'nil'}")
      if ipa_bundle_id && ipa_bundle_id != APP_IDENTIFIER
        UI.user_error!("IPA bundle ID #{ipa_bundle_id} != #{APP_IDENTIFIER}")
      end
    rescue => ex
      UI.important("⚠️  Could not read IPA bundle ID: #{ex.message}")
    end

    release_notes = generate_release_notes
    UI.message("📝 TestFlight release notes:\n#{release_notes}\n")

    pilot_opts = {
      ipa: ipa_path,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: release_notes,
      localized_build_info: {
        "en-US" => { whats_new: release_notes }
      }
    }
    pilot_opts[:api_key] = api_key if api_key

    begin
      upload_to_testflight(pilot_opts)
      UI.success("✅ Successfully uploaded to TestFlight!")
      UI.message("📱 Check App Store Connect for build processing status")
    rescue => ex
      error_msg = ex.message
      if error_msg.include?("Couldn't find app") || error_msg.include?("not found on the account")
        UI.important("🔧 App not found — creating in App Store Connect...")
        create_app
        upload_to_testflight(pilot_opts)
        UI.success("✅ Successfully uploaded to TestFlight!")
      elsif closed_app_store_train_error?(error_msg) && !skip_build
        # ASC closed this marketing version (already approved / train locked).
        # Bump CFBundleShortVersionString, sync extensions, rebuild, upload once more.
        UI.important("🚂 Pre-release train closed (ASC 90186/90062) — auto-bumping marketing version…")
        UI.important("   #{error_msg.lines.first&.strip}")
        new_name, new_build = increment_marketing_version_in_pubspec
        commit_and_push_build_number(
          new_build,
          commit_subject: "chore: Auto-bump marketing version to #{new_name}+#{new_build} [skip ci]",
          commit_body: "ASC closed the previous marketing-version train (90186/90062). Fastfile bumped patch + build and re-uploaded."
        )
        sync_extension_versions_from_pubspec!
        UI.important("📦 Rebuilding IPA at #{new_name}+#{new_build}…")
        build_ipa(export_method: "app-store")
        unless File.exist?(ipa_path)
          UI.user_error!("❌ IPA missing after rebuild at #{ipa_path}")
        end
        verify_ipa_matches_pubspec!(ipa_path)
        upload_to_testflight(pilot_opts)
        UI.success("✅ Uploaded to TestFlight after auto version bump (#{new_name}+#{new_build})")
        UI.message("📱 Check App Store Connect for build processing status")
      else
        UI.error("❌ Failed to upload to TestFlight: #{error_msg}")
        raise
      end
    end
  end

  desc "One-time: link group.com.clipval to ClipValKeyboard (Apple ID session)"
  lane :associate_keyboard_app_group do
    ensure_devcenter_app_id!(KEYBOARD_IDENTIFIER, name: "ClipVal Keyboard")
    ok = associate_app_group_via_portal!(KEYBOARD_IDENTIFIER, group_id: "group.com.clipval")
    UI.user_error!("Portal associate failed — set FASTLANE_USER/PASSWORD or Developer portal") unless ok
    fetch_appstore_profile!(app_identifier: KEYBOARD_IDENTIFIER, force: true)
    UI.success("Keyboard App Group ready — re-run Deploy")
  end

  desc "Create app in App Store Connect + Developer Portal"
  lane :create_app do
    UI.message("📱 Creating #{APP_NAME} (#{APP_IDENTIFIER}) in App Store Connect...")
    begin
      produce(
        username: APPLE_ID,
        app_identifier: APP_IDENTIFIER,
        app_name: APP_NAME,
        team_id: TEAM_ID,
        skip_itc: false,
        skip_devcenter: false
      )
      UI.success("✅ App created!")
    rescue => ex
      error_msg = ex.message
      if error_msg.include?("already exists") || error_msg.include?("already registered")
        UI.important("ℹ️  App already exists — OK to upload")
      else
        UI.error("❌ Failed to create app: #{error_msg}")
        UI.error("   Manual: https://appstoreconnect.apple.com → New App")
        UI.error("   Bundle ID: #{APP_IDENTIFIER}")
        raise
      end
    end
  end




  desc "Attach TF build + What's New + submit for App Review (deliver)"
  # Uses deliver's Review Submission flow (not deprecated appStoreVersionSubmissions CREATE).
  # bundle exec fastlane ios submit_app_store version:1.1.0 build:65
  lane :submit_app_store do |options|
    version_string = (options[:version] || ENV["SUBMIT_VERSION"] || "1.1.0").to_s
    prefer_build = (options[:build] || ENV["SUBMIT_BUILD"] || "").to_s.strip

    api_key = build_app_store_connect_api_key
    UI.user_error!("ASC API key required (APP_STORE_CONNECT_API_KEY_*)") unless api_key

    # Ensure API key file exists for any Spaceship side-calls
    key_path = File.join(Dir.home, ".appstoreconnect", "api_key.p8")
    UI.user_error!("Missing #{key_path}") unless File.exist?(key_path)

    en_path = File.join(PROJECT_ROOT, "store", "whats_new_1.1_en-US.txt")
    zh_path = File.join(PROJECT_ROOT, "store", "whats_new_1.1_zh-Hant.txt")
    review_path = File.join(PROJECT_ROOT, "store", "REVIEW_NOTES_1.1_icloud.txt")
    en_whats = File.exist?(en_path) ? File.read(en_path).strip : "Bug fixes and improvements."
    zh_whats = File.exist?(zh_path) ? File.read(zh_path).strip : en_whats
    review_notes = File.exist?(review_path) ? File.read(review_path).strip : ""

    contact_email = ENV["ASC_REVIEW_EMAIL"].to_s
    contact_email = APPLE_ID if contact_email.empty?
    contact_first = ENV["ASC_REVIEW_FIRST_NAME"].to_s
    contact_first = "Kai" if contact_first.empty?
    contact_last = ENV["ASC_REVIEW_LAST_NAME"].to_s
    contact_last = "Yu" if contact_last.empty?
    contact_phone = ENV["ASC_REVIEW_PHONE"].to_s
    # E.164 — override via ASC_REVIEW_PHONE secret if needed
    contact_phone = "+85291234567" if contact_phone.empty?

    UI.message("Submitting #{APP_IDENTIFIER} #{version_string}" + (prefer_build.empty? ? "" : " build #{prefer_build}") + " via deliver…")

    deliver_opts = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version_string,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      skip_app_version_update: false,
      force: true, # skip HTML preview confirmation on CI
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      release_notes: {
        "en-US" => en_whats,
        "zh-Hant" => zh_whats
      },
      submission_information: {
        add_id_info_uses_idfa: false,
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false,
        export_compliance_platform: "ios",
        export_compliance_compliance_required: false,
        export_compliance_encryption_updated: false,
        export_compliance_app_type: nil,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        export_compliance_contains_third_party_cryptography: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_available_on_french_store: false
      },
      app_review_information: {
        first_name: contact_first,
        last_name: contact_last,
        email_address: contact_email,
        phone_number: contact_phone,
        demo_user: "",
        demo_password: "",
        notes: review_notes
      }
    }
    deliver_opts[:build_number] = prefer_build unless prefer_build.empty?

    begin
      upload_to_app_store(deliver_opts)
      UI.success("Deliver finished — check ASC for Waiting for Review / state.")
    rescue => ex
      UI.user_error!("Deliver/submit failed: #{ex.message}")
    end
  end

  desc "Upload App Store screenshots only (no binary) — from store/screenshots/"
  # Uses Spaceship single-pass upload (not deliver overwrite_screenshots), which can
  # double-upload on retry and leave 4+4=8 duplicate slots on APP_IPHONE_67.
  lane :upload_screenshots do
    screenshots_path = File.join(PROJECT_ROOT, "store", "screenshots")
    locale_dir = File.join(screenshots_path, "en-US")
    UI.user_error!("Missing #{screenshots_path}") unless Dir.exist?(screenshots_path)
    UI.user_error!("Missing #{locale_dir}") unless Dir.exist?(locale_dir)

    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s
    key_path = File.join(Dir.home, ".appstoreconnect", "api_key.p8")
    private_key = File.join(Dir.home, "private_keys", "AuthKey_#{key_id}.p8")
    private_key = File.join(Dir.home, "private_keys", "AuthKey_GVQ92UZ87M.p8") unless File.exist?(private_key)

    if !File.exist?(key_path) && File.exist?(private_key)
      FileUtils.mkdir_p(File.dirname(key_path))
      FileUtils.cp(private_key, key_path)
    end

    UI.user_error!("Missing API key id (APP_STORE_CONNECT_API_KEY_ID)") if key_id.empty?
    UI.user_error!("Missing issuer id (APP_STORE_CONNECT_ISSUER_ID)") if issuer_id.empty?
    UI.user_error!("Missing API key file at #{key_path}") unless File.exist?(key_path)

    files = Dir[File.join(locale_dir, "*.png")].sort
    UI.user_error!("No PNGs in #{locale_dir}") if files.empty?
    UI.message("🖼️  Single-pass upload of #{files.size} screenshot(s) from #{locale_dir}…")
    files.each { |f| UI.message("   • #{File.basename(f)}") }

    token = Spaceship::ConnectAPI::Token.create(
      key_id: key_id,
      issuer_id: issuer_id,
      filepath: key_path
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found: #{APP_IDENTIFIER}") unless app

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version") unless version

    loc = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    UI.user_error!("Missing en-US localization on version #{version.version_string}") unless loc

    display_type = "APP_IPHONE_67"
    set = loc.get_app_screenshot_sets.find { |s| s.screenshot_display_type == display_type }
    unless set
      set = Spaceship::ConnectAPI::AppScreenshotSet.create(
        app_store_version_localization_id: loc.id,
        screenshot_display_type: display_type
      )
    end

    existing = set.app_screenshots || []
    UI.message("Clearing #{existing.size} existing #{display_type} screenshot(s)…") if existing.any?
    existing.each do |shot|
      Spaceship::ConnectAPI.delete_app_screenshot(app_screenshot_id: shot.id)
    end

    files.each_with_index do |path, idx|
      UI.message("Upload #{idx + 1}/#{files.size}: #{File.basename(path)}")
      set.upload_screenshot(path: path, wait_for_processing: true)
    end

    set = loc.get_app_screenshot_sets.find { |s| s.screenshot_display_type == display_type }
    final = set.app_screenshots || []
    UI.user_error!("Expected #{files.size} screenshots, ASC has #{final.size}") unless final.size == files.size
    UI.success("✅ Screenshots uploaded to App Store Connect (#{final.size} on #{display_type}, no duplicates)")
  end

  desc "Revoke excess API-created Development certs on CI (frees Apple cert slots)"
  lane :prune_excess_certificates_for_ci do
    return unless ENV["CI"]
    return unless connect_api_for_spaceship

    revoked_ids = []
    %w[DEVELOPMENT IOS_DEVELOPMENT].each do |type|
      prune_certificates_of_type(type, keep: 0, revoked_ids: revoked_ids)
    end
  end

  desc "Setup App Store distribution certificate + provisioning profile"
  lane :setup_appstore_signing do
    UI.message("🔧 Setting up App Store distribution signing for #{APP_IDENTIFIER}...")
    api_key_params = app_store_connect_api_key_params

    begin
      if ENV["CI"]
        unless api_key_params
          UI.user_error!(
            "APP_STORE_CONNECT_API_KEY_ID, ISSUER_ID, and API_KEY_CONTENT must be set for CI."
          )
        end
        import_distribution_certificate_for_ci!
        unless distribution_identity_installed?
          UI.user_error!(
            "No Apple Distribution identity in keychain. Set GitHub secrets " \
            "IOS_DISTRIBUTION_CERT_BASE64 and IOS_DISTRIBUTION_CERT_PASSWORD."
          )
        end
        UI.message("📜 Reusing imported Apple Distribution certificate on CI")
      else
        UI.message("📜 Getting App Store Distribution certificate...")
        api_key = build_app_store_connect_api_key
        if api_key
          get_certificates(
            development: false,
            api_key: api_key,
            team_id: TEAM_ID
          )
        else
          get_certificates(
            development: false,
            username: APPLE_ID,
            team_id: TEAM_ID
          )
        end
      end

      UI.message("📋 Getting App Store provisioning profile for #{APP_IDENTIFIER}...")
      main_profile = fetch_appstore_profile!(
        app_identifier: APP_IDENTIFIER,
        force: ENV["CI"] == "true"
      )
      ENV["SIGH_NAME"] = main_profile

      UI.message("📋 Getting App Store provisioning profile for #{WIDGET_IDENTIFIER}...")
      widget_profile = fetch_appstore_profile!(
        app_identifier: WIDGET_IDENTIFIER,
        force: ENV["CI"] == "true"
      )
      ENV["SIGH_NAME_WIDGET"] = widget_profile

      UI.message("📋 Getting App Store provisioning profile for #{SHARE_IDENTIFIER}...")
      share_profile = fetch_appstore_profile!(
        app_identifier: SHARE_IDENTIFIER,
        force: ENV["CI"] == "true"
      )
      ENV["SIGH_NAME_SHARE"] = share_profile

      ensure_devcenter_app_id!(KEYBOARD_IDENTIFIER, name: "ClipVal Keyboard")
      UI.message("📋 Getting App Store provisioning profile for #{KEYBOARD_IDENTIFIER}...")
      # Always force-refresh: capability/group changes invalidate old profiles.
      keyboard_profile = fetch_appstore_profile!(
        app_identifier: KEYBOARD_IDENTIFIER,
        force: true
      )
      ENV["SIGH_NAME_KEYBOARD"] = keyboard_profile
      # Restore main SIGH_NAME (fetch overwrites it)
      ENV["SIGH_NAME"] = main_profile

      persist_ci_signing_env!

      UI.success(
        "✅ Profiles ready! SIGH_NAME=#{main_profile} " \
        "SIGH_NAME_WIDGET=#{widget_profile} SIGH_NAME_SHARE=#{share_profile} " \
        "SIGH_NAME_KEYBOARD=#{keyboard_profile}"
      )
    rescue => ex
      UI.important("⚠️  Automatic setup failed: #{ex.message}")
      UI.important("   open ios/Runner.xcworkspace → Signing & Capabilities → team #{TEAM_ID}")
      raise
    end
  end

  desc "Increment build number in Xcode project only"
  lane :increment_build do
    increment_build_number(xcodeproj: "#{IOS_DIR}/Runner.xcodeproj")
    UI.success("✅ Build number incremented!")
  end

  desc "Clean iOS build artifacts"
  lane :clean do
    sh("cd #{PROJECT_ROOT} && flutter clean")
    sh("cd #{IOS_DIR} && rm -rf Pods Podfile.lock")
    begin
      sh(
        "cd #{IOS_DIR} && env -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH " \
        "#{find_pod_command} install",
        log: false
      )
    rescue => _ex
      # optional
    end
    UI.success("✅ Clean completed!")
  end
end

# --- Android / Google Play (Internal Testing ≈ TestFlight) ---

ANDROID_PACKAGE_NAME = "com.clipval"
ANDROID_DIR = File.join(PROJECT_ROOT, "android")
ANDROID_AAB_PATH = File.join(
  PROJECT_ROOT,
  "build/app/outputs/bundle/release/app-release.aab"
)

def android_has_release_signing?
  props = File.join(ANDROID_DIR, "key.properties")
  return true if File.exist?(props)

  %w[
    ANDROID_KEYSTORE_PATH
    ANDROID_KEYSTORE_PASSWORD
    ANDROID_KEY_ALIAS
    ANDROID_KEY_PASSWORD
  ].all? { |k| !ENV[k].to_s.strip.empty? }
end

def ensure_android_release_signing!
  return if android_has_release_signing?

  UI.user_error!(
    "Missing Android release signing.\n" \
    "  Local:  ./scripts/create_android_keystore.sh  → android/key.properties\n" \
    "  CI:     secrets ANDROID_KEYSTORE_BASE64 + ANDROID_KEYSTORE_PASSWORD + " \
    "ANDROID_KEY_ALIAS + ANDROID_KEY_PASSWORD\n" \
    "  Docs:   docs/CI_PLAY.md"
  )
end

# Resolve Google Play service-account JSON for supply / upload_to_play_store.
# Prefer file path; support raw JSON or base64 env for CI.
def play_store_json_key_path!
  path = ENV["PLAY_STORE_JSON_KEY_PATH"].to_s.strip
  return path if !path.empty? && File.exist?(path)

  # Common local drop locations
  [
    File.join(ANDROID_DIR, "play-store-key.json"),
    File.expand_path("~/.config/clipval/play-store-key.json"),
  ].each do |candidate|
    return candidate if File.exist?(candidate)
  end

  content = ENV["PLAY_STORE_JSON_KEY"].to_s.strip
  is_b64 = ENV["PLAY_STORE_JSON_KEY_IS_BASE64"] == "true" ||
           ENV["PLAY_STORE_JSON_KEY_BASE64"].to_s.strip != ""

  if content.empty? && ENV["PLAY_STORE_JSON_KEY_BASE64"].to_s.strip != ""
    content = ENV["PLAY_STORE_JSON_KEY_BASE64"].to_s.strip
    is_b64 = true
  end

  UI.user_error!(
    "Missing Google Play service-account key.\n" \
    "  Set PLAY_STORE_JSON_KEY_PATH to a JSON file, or\n" \
    "  PLAY_STORE_JSON_KEY / PLAY_STORE_JSON_KEY_BASE64 (CI secret).\n" \
    "  See docs/CI_PLAY.md"
  ) if content.empty?

  out = File.join(ANDROID_DIR, "play-store-key.ci.json")
  FileUtils.mkdir_p(File.dirname(out))
  if is_b64
    require "base64"
    File.binwrite(out, Base64.decode64(content))
  else
    File.write(out, content)
  end
  File.chmod(0600, out)
  out
end

def flutter_build_appbundle!
  ensure_android_release_signing!
  sh("cd #{PROJECT_ROOT} && flutter pub get")
  git_def = flutter_git_define_args
  UI.message("📦 Building Android App Bundle (release)…")
  sh("cd #{PROJECT_ROOT} && flutter build appbundle --release #{git_def}")
  UI.user_error!("❌ AAB not found at #{ANDROID_AAB_PATH}") unless File.exist?(ANDROID_AAB_PATH)
  UI.success("✅ AAB ready: #{ANDROID_AAB_PATH}")
  ANDROID_AAB_PATH
end

# supply reads en-US/changelogs/{versionCode}.txt under metadata_path (max 500 chars).
def play_metadata_path_with_changelog!(notes)
  root = File.join(ANDROID_DIR, ".play_metadata")
  FileUtils.rm_rf(root)
  dir = File.join(root, "en-US", "changelogs")
  FileUtils.mkdir_p(dir)

  text = notes.to_s.strip
  text = "ClipVal build" if text.empty?
  text = text[0, 500]

  _, _, _, build = read_pubspec_version
  File.write(File.join(dir, "#{build}.txt"), text)
  File.write(File.join(dir, "default.txt"), text)
  root
end

platform :android do
  desc "Build Android debug APK"
  lane :build_debug do
    sh("cd #{PROJECT_ROOT} && flutter pub get")
    sh("cd #{PROJECT_ROOT} && flutter build apk --debug")
    UI.success("✅ Android Debug APK built")
    UI.message("📦 #{PROJECT_ROOT}/build/app/outputs/flutter-apk/app-debug.apk")
  end

  desc "Build Android release APK (requires release signing for Play-ready binary)"
  lane :build_release_apk do
    ensure_android_release_signing!
    sh("cd #{PROJECT_ROOT} && flutter pub get")
    git_def = flutter_git_define_args
    sh("cd #{PROJECT_ROOT} && flutter build apk --release #{git_def}")
    UI.success("✅ Android Release APK built")
    UI.message("📦 #{PROJECT_ROOT}/build/app/outputs/flutter-apk/app-release.apk")
  end

  desc "Build Android release App Bundle (.aab) for Play Console"
  lane :build_release_bundle do
    flutter_build_appbundle!
  end

  desc "Build AAB and upload to Google Play Internal Testing (TestFlight equivalent)"
  desc "Options: skip_build:true — upload existing AAB only; track: internal|alpha|beta|production"
  lane :upload_internal do |options|
    skip_build = options[:skip_build] || false
    track = (options[:track] || ENV["PLAY_TRACK"] || "internal").to_s

    unless skip_build
      UI.important("🔢 Auto-incrementing build number…")
      new_build_number = increment_build_number_in_pubspec
      commit_and_push_build_number(new_build_number)
      UI.important("")

      flutter_build_appbundle!
    end

    UI.user_error!(
      "❌ AAB not found at #{ANDROID_AAB_PATH}. Build first or omit skip_build."
    ) unless File.exist?(ANDROID_AAB_PATH)

    json_key = play_store_json_key_path!
    release_notes = generate_release_notes
    metadata_path = play_metadata_path_with_changelog!(release_notes)
    UI.message("📝 Play release notes:\n#{release_notes}\n")
    UI.message("🚀 Uploading to Play track=#{track} (package=#{ANDROID_PACKAGE_NAME})…")

    # Internal / closed testing = closest to TestFlight. Store listing /
    # screenshots stay in Play Console (or a future metadata lane).
    begin
      upload_to_play_store(
        package_name: ANDROID_PACKAGE_NAME,
        track: track,
        aab: ANDROID_AAB_PATH,
        json_key: json_key,
        metadata_path: metadata_path,
        skip_upload_metadata: true,
        skip_upload_changelogs: false,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_apk: true,
        release_status: "completed"
      )
      UI.success("✅ Uploaded to Google Play (#{track})")
      UI.message("📱 Play Console → Testing → Internal testing → manage testers / share link")
    rescue => ex
      msg = ex.message.to_s
      if msg.include?("Package not found") || msg.include?("404") ||
         (msg.downcase.include?("not found") && msg.include?("com.clipval"))
        UI.error("❌ Play app not found for package #{ANDROID_PACKAGE_NAME}")
        UI.error("   Create the app once in Play Console with applicationId com.clipval")
        UI.error("   Docs: docs/CI_PLAY.md")
      elsif msg.include?("Version code") && msg.include?("already been used")
        UI.error("❌ versionCode already on Play — bump pubspec build and re-run")
      end
      raise
    ensure
      FileUtils.rm_rf(File.join(ANDROID_DIR, ".play_metadata"))
    end
  end

  desc "Alias: upload to Play production track (use with care)"
  lane :upload_production do |options|
    upload_internal(options.merge(track: "production"))
  end

  desc "Clean Android build artifacts"
  lane :clean do
    sh("cd #{PROJECT_ROOT} && flutter clean")
    sh("cd #{PROJECT_ROOT}/android && ./gradlew clean")
    UI.success("✅ Clean completed!")
  end
end

desc "Get Flutter dependencies"
lane :get_dependencies do
  sh("cd #{PROJECT_ROOT} && flutter pub get")
  UI.success("✅ Dependencies fetched!")
end

desc "Run Flutter tests"
lane :test do
  sh("cd #{PROJECT_ROOT} && flutter test")
  UI.success("✅ Tests completed!")
end

desc "Clean all build artifacts"
lane :clean_all do
  sh("cd #{PROJECT_ROOT} && flutter clean")
  sh("cd #{IOS_DIR} && rm -rf Pods Podfile.lock")
  begin
    sh(
      "cd #{IOS_DIR} && env -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH " \
      "#{find_pod_command} install",
      log: false
    )
  rescue => _ex
    # optional
  end
  sh("cd #{PROJECT_ROOT}/android && ./gradlew clean")
  UI.success("✅ All build artifacts cleaned!")
end
